#!/usr/bin/env bash
set -xeuo pipefail
# Integration helper - clones SUSFS and KernelSU into the kernel tree
# This script is intended to be invoked from the repo root (CI/workflow)

SUSFS_URL="${SUSFS_URL:-https://gitlab.com/simonpunk/susfs4ksu.git}"
KERNELSU_URL="${KERNELSU_URL:-https://github.com/tiann/KernelSU.git}"
SUSFS_DIR="fs/susfs"
KERNELSU_DIR="security/kernelsu"

# Clone third-party sources
rm -rf /tmp/susfs_src /tmp/kernelsu_src
git clone --depth 1 "${SUSFS_URL}" /tmp/susfs_src
git clone --depth 1 "${KERNELSU_URL}" /tmp/kernelsu_src

# Copy into kernel tree
rm -rf "${SUSFS_DIR}" "${KERNELSU_DIR}"
mkdir -p "${SUSFS_DIR}" "${KERNELSU_DIR}"
rsync -a /tmp/susfs_src/ "${SUSFS_DIR}/"
rsync -a /tmp/kernelsu_src/ "${KERNELSU_DIR}/"

# Create minimal Kconfig/Makefile for susfs
cat > "${SUSFS_DIR}/Kconfig" <<'KCONF'
config SUSFS
    bool "susfs filesystem"
    help
      SUSFS integration for KernelSU.
KCONF

cat > "${SUSFS_DIR}/Makefile" <<'MFILE'
obj-$(CONFIG_SUSFS) += susfs/
MFILE

# Ensure fs/Kconfig sources susfs Kconfig
if ! grep -Fq 'fs/susfs/Kconfig' fs/Kconfig; then
  echo '' >> fs/Kconfig
  echo 'source "fs/susfs/Kconfig"' >> fs/Kconfig
fi

# Ensure fs/Makefile builds susfs
if ! grep -Fq 'obj-$(CONFIG_SUSFS)' fs/Makefile; then
  echo >> fs/Makefile
  echo '# SUSFS' >> fs/Makefile
  echo 'obj-$(CONFIG_SUSFS) += susfs/' >> fs/Makefile
fi

# Create minimal Kconfig/Makefile for KernelSU
cat > "${KERNELSU_DIR}/Kconfig" <<'KCONF'
config KERNELSU
    bool "KernelSU support"
    help
      KernelSU integration (in-kernel root management support).
KCONF

cat > "${KERNELSU_DIR}/Makefile" <<'MFILE'
obj-$(CONFIG_KERNELSU) += kernelsu/
MFILE

# Ensure security/Kconfig sources kernelsu Kconfig
if ! grep -Fq 'security/kernelsu/Kconfig' security/Kconfig; then
  echo '' >> security/Kconfig
  echo 'source "security/kernelsu/Kconfig"' >> security/Kconfig
fi

# Ensure security/Makefile builds kernelsu
if ! grep -Fq 'obj-$(CONFIG_KERNELSU)' security/Makefile; then
  echo >> security/Makefile
  echo '# KernelSU' >> security/Makefile
  echo 'obj-$(CONFIG_KERNELSU) += kernelsu/' >> security/Makefile
fi

echo "Integration complete."
